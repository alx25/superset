# Variables de entorno de los servicios de Superset con la plantilla
# config-templates/superset_config.template.py.
#
# Crear DOS archivos fuera del repo, con permisos 600, a partir de este:
#   /home/imercados/superset_proyecto/.env_superset      → superset, celery,
#        celery-async, celery-beat, flower (sección GENERAL + WEB)
#   /home/imercados/superset_proyecto/.env_superset_mcp  → superset_mcp
#        (sección GENERAL + MCP)
# La plantilla lee los secretos y las IREX_* al cargarse, en TODOS los procesos:
# las dos copias necesitan la sección GENERAL completa.
# Nunca commitear valores reales.
#
# Generar secretos:  python3 -c 'import secrets; print(secrets.token_urlsafe(48))'

# ===================== GENERAL (los dos archivos) =====================
SUPERSET_DIR=/home/imercados/superset_proyecto/superset_v6_1_0
SUPERSET_CONFIG_PATH=/home/imercados/.superset/superset_config.py
SUPERSET_ENV=production

# --- Secretos ---
SUPERSET_SECRET_KEY=
SUPERSET_DB_URI=postgresql://USUARIO:CLAVE@localhost:5432/superset
SUPERSET_GLOBAL_ASYNC_QUERIES_JWT_SECRET=
# Compartido con el backend del chat: el widget firma los JWT del MCP con este secreto.
IREX_MCP_JWT_SECRET=
# Compartido con el backend del chat: header X-Service-Secret.
IREX_CHAT_BACKEND_SECRET=

# --- Datos propios del servidor ---
IREX_CHAT_WIDGET_URL=http://HOST_CHAT:8008/web/widget.js
IREX_CHAT_WIDGET_API_URL=http://HOST_CHAT:8008
IREX_MCP_WIDGET_URL=http://IP_DEL_SERVIDOR:5008
SUPERSET_WEBDRIVER_BASEURL_USER_FRIENDLY=http://IP_DEL_SERVIDOR/
IREX_EXTENSIONS_PATH=/home/imercados/superset_proyecto/extensions
IREX_MCP_EXPORT_BASE_URL=http://IP_DEL_SERVIDOR

# --- Opcionales (la plantilla los lee con os.environ.get) ---
MAPBOX_API_KEY=
SMTP_USER=
SMTP_PASSWORD=
SMTP_MAIL_FROM=

# clickhouse-connect: su módulo nativo revienta (SIGSEGV) bajo gunicorn gevent;
# con 0 usa el fallback en Python. Obligatorio si hay bases ClickHouse.
CLICKHOUSE_CONNECT_USE_C=0

# ===================== WEB (solo .env_superset) =====================
SUPERSET_PORT=8088
CELERY_BROKER_URL=redis://localhost:6379/0
# usuario:clave para la interfaz de flower
FLOWER_BASIC_AUTH=

# ===================== MCP (solo .env_superset_mcp) =====================
MCP_PORT=5008
